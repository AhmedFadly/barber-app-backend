// REGENT Grooming Co. — barber shop booking platform.
// Money is stored in fils (AED × 100). Times are stored in UTC; the shop runs on Asia/Dubai (UTC+4, no DST).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  area         String
  address      String
  phone        String
  imageUrl     String
  latitude     Float
  longitude    Float
  /// [{ weekday: 0-6 (Sun=0), open: "10:00", close: "22:00" }]
  openingHours Json
  active       Boolean       @default(true)
  sortOrder    Int           @default(0)
  barbers      Barber[]
  appointments Appointment[]
  createdAt    DateTime      @default(now())
}

model ServiceCategory {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sortOrder Int       @default(0)
  services  Service[]
}

model Service {
  id          String               @id @default(cuid())
  slug        String               @unique
  name        String
  description String
  durationMin Int
  priceFils   Int
  imageUrl    String
  popular     Boolean              @default(false)
  active      Boolean              @default(true)
  sortOrder   Int                  @default(0)
  categoryId  String
  category    ServiceCategory      @relation(fields: [categoryId], references: [id])
  barbers     BarberService[]
  bookings    AppointmentService[]
}

model Barber {
  id           String          @id @default(cuid())
  name         String
  title        String
  bio          String
  photoUrl     String
  rating       Float           @default(5)
  active       Boolean         @default(true)
  branchId     String
  branch       Branch          @relation(fields: [branchId], references: [id])
  services     BarberService[]
  shifts       Shift[]
  timeOff      TimeOff[]
  appointments Appointment[]
}

model BarberService {
  barberId  String
  serviceId String
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
}

/// Weekly working hours. Minutes from local midnight.
model Shift {
  id       String @id @default(cuid())
  barberId String
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
  weekday  Int
  startMin Int
  endMin   Int

  @@index([barberId, weekday])
}

model TimeOff {
  id       String   @id @default(cuid())
  barberId String
  barber   Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  startsAt DateTime
  endsAt   DateTime
  reason   String?
}

enum Tier {
  SILVER
  GOLD
  BLACK
}

model Customer {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String
  birthday       DateTime?
  pointsBalance  Int           @default(0)
  lifetimePoints Int           @default(0)
  creditFils     Int           @default(0)
  tier           Tier          @default(SILVER)
  referralCode   String        @unique
  marketingOptIn Boolean       @default(true)
  appointments   Appointment[]
  pointsEntries  PointsEntry[]
  creditEntries  CreditEntry[]
  pushTokens     PushToken[]
  giftCardsSent  GiftCard[]    @relation("GiftCardPurchaser")
  giftCardsUsed  GiftCard[]    @relation("GiftCardRedeemer")
  favouriteBarberId String?
  createdAt      DateTime      @default(now())
}

model PushToken {
  id         String   @id @default(cuid())
  token      String   @unique
  platform   String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  DEPOSIT_PAID
  PAID
  REFUNDED
}

model Appointment {
  id              String               @id @default(cuid())
  reference       String               @unique
  customerId      String
  customer        Customer             @relation(fields: [customerId], references: [id])
  branchId        String
  branch          Branch               @relation(fields: [branchId], references: [id])
  barberId        String
  barber          Barber               @relation(fields: [barberId], references: [id])
  startsAt        DateTime
  endsAt          DateTime
  status          AppointmentStatus    @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus        @default(UNPAID)
  subtotalFils    Int
  creditUsedFils  Int                  @default(0)
  depositFils     Int
  notes           String?
  items           AppointmentService[]
  payments        Payment[]
  reminderSentAt  DateTime?
  cancelledAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime             @default(now())

  @@index([barberId, startsAt])
  @@index([customerId, startsAt])
}

model AppointmentService {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id])
  name          String
  priceFils     Int
  durationMin   Int
}

enum PaymentPurpose {
  DEPOSIT
  GIFT_CARD
}

enum PaymentState {
  PENDING
  SUCCEEDED
  FAILED
}

model Payment {
  id            String         @id @default(cuid())
  purpose       PaymentPurpose
  provider      String
  providerRef   String?        @unique
  amountFils    Int
  state         PaymentState   @default(PENDING)
  appointmentId String?
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  giftCardId    String?        @unique
  giftCard      GiftCard?      @relation(fields: [giftCardId], references: [id])
  createdAt     DateTime       @default(now())
}

model GiftCard {
  id             String    @id @default(cuid())
  code           String    @unique
  amountFils     Int
  recipientName  String
  recipientEmail String?
  message        String?
  purchaserId    String?
  purchaser      Customer? @relation("GiftCardPurchaser", fields: [purchaserId], references: [id])
  redeemedById   String?
  redeemedBy     Customer? @relation("GiftCardRedeemer", fields: [redeemedById], references: [id])
  redeemedAt     DateTime?
  active         Boolean   @default(false)
  payment        Payment?
  createdAt      DateTime  @default(now())
}

/// Append-only ledger. Positive = earned, negative = redeemed.
model PointsEntry {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  points        Int
  reason        String
  /// Idempotency key, e.g. "visit:<appointmentId>"
  sourceKey     String?  @unique
  createdAt     DateTime @default(now())
}

/// Append-only ledger for wallet credit (gift cards, points conversion, spend, refunds).
model CreditEntry {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  amountFils Int
  reason     String
  sourceKey  String?  @unique
  createdAt  DateTime @default(now())
}

model NewsPost {
  id          String    @id @default(cuid())
  title       String
  summary     String
  body        String
  imageUrl    String
  tag         String    @default("News")
  pinned      Boolean   @default(false)
  published   Boolean   @default(true)
  publishedAt DateTime  @default(now())
  pushedAt    DateTime?
}

/// Single-row shop settings.
model Settings {
  id                   Int     @id @default(1)
  depositPercent       Int     @default(25)
  cancellationHours    Int     @default(12)
  slotStepMin          Int     @default(15)
  bookingWindowDays    Int     @default(30)
  pointsPerAed         Int     @default(1)
  /// Points needed for one redemption block, and AED credit it gives.
  redeemBlockPoints    Int     @default(500)
  redeemBlockFils      Int     @default(5000)
  goldThreshold        Int     @default(1000)
  blackThreshold       Int     @default(3000)
  reminderHoursBefore  Int     @default(3)
}
